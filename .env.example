# Odoo Connection Settings
ODOO_URL=http://localhost:8069
ODOO_DB=your_database_name
ODOO_USERNAME=your_username_or_email
ODOO_API_KEY=your_odoo_api_key

# Required for all mutation/settings endpoints. Generate a random value and
# inject it via a secret manager; never commit the real value.
WRITE_API_TOKEN=replace_with_a_long_random_secret

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Local LLM Configuration (Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=120
LLM_MAX_TOKENS=1024

# Audio / Transcription (Optional)
WHISPER_MODEL=base
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
