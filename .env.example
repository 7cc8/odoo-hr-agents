# Odoo Connection Settings
ODOO_URL=http://localhost:8069
ODOO_DB=your_database_name
ODOO_USERNAME=your_username_or_email
ODOO_API_KEY=your_odoo_api_key

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# AI & LLM Models (Seraj & OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Audio / Transcription (Optional)
WHISPER_MODEL=base
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key

# ──────────────────────────────────────────────────────────────────────────────
# Laya Neural Consultant (الاستشارة العصبية للوكلاء)
# ──────────────────────────────────────────────────────────────────────────────
# LAYA_ENABLED: تفعيل الاستشارة العصبية (disabled افتراضياً لأمان المسار)
# القيمة: true | false (الافتراضي: false)
LAYA_ENABLED=false

# LAYA_MODE: وضع الاستشارة
#   shadow   → يُشغَّل النموذج ويُسجَّل الاقتراح للمقارنة دون إدخاله بالسياق
#   advisory → الاقتراح معلومة غير ملزمة قابلة للاستخدام من المنسق
# الوضع الآمن الافتراضي: shadow
LAYA_MODE=shadow

# ملاحظات:
# - الأوزان موجودة في laya-models/multilingual/ (مُنزَّلة مسبقاً)
# - عند أول تشغيل بـ LAYA_ENABLED=true يُحمَّل النموذج (~600MB) على CPU
# - الاستشارة العصبية لا تمنح اعتماداً ولا تُنفّذ كتابة في Odoo
# - السجل في logs/laya_consultation_audit.jsonl
